# ==============================================================================
# MyHealthChain — Environment Configuration (.env.example)
# IMPORTANT: Provide actual values in your local .env or Google Secret Manager.
# NEVER commit sensitive API keys or credentials to version control.
# ==============================================================================

# --- Google Gemini Reasoning Engine (Required for Decision Coach & Insights) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Server & Environment ---
ENVIRONMENT=development
PORT=8080
ALLOW_DEV_FALLBACK_AUTH=true

# --- Database & Auth (Supabase PostgreSQL) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Frontend Client Configuration ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_API_URL=http://localhost:8000

# --- LLM Observability & Grounding (Optional / Langfuse) ---
LANGFUSE_PUBLIC_KEY=pk-lf-placeholder
LANGFUSE_SECRET_KEY=sk-lf-placeholder
LANGFUSE_HOST=https://cloud.langfuse.com
